erDiagram
  CUENTA ||--o{ PEDIDO : recibe
  PEDIDO ||--|{ DETALLE_PEDIDO : contiene
  PRODUCTO ||--o{ DETALLE_PEDIDO : solicitado
  PRODUCTO ||--o{ RECETA_DETALLE : requiere
  INSUMO ||--o{ RECETA_DETALLE : participa
  INSUMO ||--o{ MOVIMIENTO_INVENTARIO : registra
  PRODUCTO ||--o{ PROMOCION_PRODUCTO : admite
  PROMOCION ||--o{ PROMOCION_PRODUCTO : aplica
  PRODUCTO {
    int ProductoId PK
    string Nombre
    string Tipo "ALIMENTO o BEBIDA"
    decimal PrecioVenta
    string UnidadVenta "unidad u onza"
    bool Disponible
  }
  INSUMO {
    int InsumoId PK
    string Nombre
    string UnidadBase
    decimal Existencia
    decimal Reservado
    binary Version
  }
  RECETA_DETALLE {
    int ProductoId PK,FK
    int InsumoId PK,FK
    decimal CantidadPorUnidadVenta
  }
  MOVIMIENTO_INVENTARIO {
    bigint MovimientoId PK
    int InsumoId FK
    bigint EventoId FK "nullable"
    int DetallePedidoId FK "nullable"
    decimal CantidadFirmada
    string Tipo
    string Motivo
    string ClaveIdempotente UK
    datetime FechaUTC
  }
  PEDIDO {
    int PedidoId PK
    int CuentaId FK
    string Estado
    string ClaveIdempotente UK
    datetime CreadoUTC
  }
  DETALLE_PEDIDO {
    int DetallePedidoId PK
    int PedidoId FK
    int ProductoId FK
    int Cantidad
    decimal PrecioUnitarioAplicado
    string Observaciones
  }
  PROMOCION {
    int PromocionId PK
    string Nombre
    datetime DesdeUTC
    datetime HastaUTC
    string TipoDescuento
    decimal Valor
    int Prioridad
  }
  PROMOCION_PRODUCTO {
    int PromocionId PK,FK
    int ProductoId PK,FK
  }
