  SURTIDOR {
    int SurtidorId PK
    int ProductoId FK
    string Identificador UK
    string CredencialReferencia
    string Estado
  }
  AUTORIZACION_SERVICIO {
    int AutorizacionId PK
    int SurtidorId FK
    int AsignacionId FK
    decimal OnzasMaximas
    decimal PrecioOnzaAplicado
    datetime VenceUTC
    string Estado
  }
  RESERVA_INVENTARIO {
    int AutorizacionId PK,FK
    int InsumoId PK,FK
    decimal CantidadReservada
    decimal CantidadConsumida
    string Estado
  }
  EVENTO_CONSUMO {
    bigint EventoId PK
    string IdentificadorExterno UK
    int AutorizacionId FK
    decimal OnzasReales
    datetime DispensadoUTC
    datetime RecibidoUTC
    string EstadoProcesamiento
  }
  CARGO_CUENTA {
    bigint CargoId PK
    int CuentaId FK
    bigint EventoId FK,UK "nullable para otros conceptos"
    decimal Cantidad
    decimal PrecioUnitario
    decimal Descuento
    decimal ImporteFirmado
  }
