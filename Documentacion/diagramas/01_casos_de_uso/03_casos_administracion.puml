@startuml
 top to bottom direction
 actor "Personal" as Personal
 actor Administrador
 actor Mesero
 actor Cajero
 actor "Encargado de Karaoke" as Karaoke
 Administrador --|> Personal
 Mesero --|> Personal
 Cajero --|> Personal
 Karaoke --|> Personal
 rectangle "ArcanosBar: administración" {
   usecase "CU-01 Iniciar sesión" as CU01
   usecase "CU-02 Administrar usuarios y roles" as CU02
   usecase "CU-03 Administrar salas y bloques" as CU03
   usecase "CU-11 Administrar menú" as CU11
   usecase "CU-14 Configurar bebidas e inventario" as CU14
   usecase "CU-22 Ajustes y devoluciones" as CU22
   usecase "CU-23 Consultar o exportar reportes" as CU23
   usecase "CU-24 Configurar promociones" as CU24
   usecase "CU-25 Consultar bitácora y conciliación" as CU25
   usecase "Registrar auditoría" as Auditar
 }
 Personal -- CU01
 Administrador -- CU02
 Administrador -- CU03
 Administrador -- CU11
 Administrador -- CU14
 Administrador -- CU22
 Administrador -- CU23
 Administrador -- CU24
 Administrador -- CU25
 CU02 ..> Auditar : <<include>>
 CU14 ..> Auditar : <<include>>
 CU22 ..> Auditar : <<include>>
 CU24 ..> Auditar : <<include>>
 note bottom of CU01
   Autenticación es precondición de operaciones protegidas.
   Los permisos se verifican también en la API.
 end note
@enduml
