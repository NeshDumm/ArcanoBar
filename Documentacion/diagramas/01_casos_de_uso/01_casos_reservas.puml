@startuml
 top to bottom direction
 actor Cliente
 actor Cajero
 actor "Pasarela de pagos" as Pasarela
 rectangle "ArcanosBar: reservas y recepción" {
   usecase "CU-04 Consultar disponibilidad" as CU04
   usecase "CU-05 Registrar reserva" as CU05
   usecase "Validar aforo y solapamiento" as Validar
   usecase "Calcular costo y anticipo" as Calcular
   usecase "CU-06 Pagar anticipo" as CU06
   usecase "CU-07 Consultar o cancelar reserva" as CU07
   usecase "CU-08 Validar llegada y abrir sesión" as CU08
   usecase "Aplicar anticipo a la cuenta" as Aplicar
   usecase "CU-09 Asociar o desactivar RFID" as CU09
   usecase "CU-10 Acceder por QR" as CU10
 }
 Cliente -- CU04
 Cliente -- CU05
 Cliente -- CU06
 Cliente -- CU07
 Cliente -- CU10
 Cajero -- CU08
 Cajero -- CU09
 Pasarela -- CU06
 CU05 ..> Validar : <<include>>
 CU05 ..> Calcular : <<include>>
 CU08 ..> Aplicar : <<include>>
 note bottom of CU05
   Costo = personas x USD 10
   Anticipo = 50% del costo
   Confirmación solo tras pago verificado
 end note
@enduml
